{
  "name": "@formizeflow/sdk",
  "version": "0.1.0",
  "description": "Typed client for the FormFlow REST API: forms, submissions, experiments, onboarding decisions and webhook verification.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/formizeflow/formflow-js.git" },
  "homepage": "https://github.com/formizeflow/formflow-js#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": { "@types/node": "^22.10.0", "tsup": "^9.0.0", "typescript": "^5.7.0", "vitest": "^3.0.0" },
  "publishConfig": { "access": "public", "provenance": true }
}
